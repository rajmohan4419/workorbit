{
  "manifest_version": 3,
  "name": "OrbitBoard - Quick Tools & Utilities",
  "version": "1.0.0",
  "description": "Instant developer utilities, calculators, converters, and quick launch to 50+ tools on OrbitBoard.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "OrbitBoard Tools"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab",
    "sidePanel"
  ]
}
