# Orbit Board — Environment Variables Setup
# Copy this file to .env and populate with your API keys

# TMDB API Key (https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=

# Supabase Configuration (https://supabase.com/dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key for Market Lab AI Stock Analysis
GEMINI_API_KEY=

# Razorpay Configuration (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=
